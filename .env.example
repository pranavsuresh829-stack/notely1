# Copy this file to .env.local and fill in your own keys.
# Everyone who deploys this app uses their own keys — nobody else's usage
# ever touches your account, and you never touch anyone else's.

# --- Supabase (Postgres + file storage + auth) ---
# Create a free project at https://supabase.com/dashboard, then:
# Project Settings -> API -> Project URL / anon public key / service_role key
# Run supabase/migrations/0001_init.sql and 0002_auth.sql against your project
# (SQL Editor, or `supabase db push`).
# Sign-in is magic-link email — no extra setup needed, Supabase's default
# project already has email auth enabled with a built-in (rate-limited) mail
# sender that's fine for personal use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Transcription (pick one provider) ---
# "groq" (cheapest + has a free tier), "openai", or "assemblyai"
TRANSCRIPTION_PROVIDER=groq

# --- Note/flashcard/quiz generation (pick one provider) ---
# "groq" (cheapest + has a free tier), "anthropic", or "ollama" (fully local, $0, no key —
# but only works when running this app locally; see below)
LLM_PROVIDER=groq

# --- Groq: used for TRANSCRIPTION_PROVIDER=groq and/or LLM_PROVIDER=groq ---
# One key covers both. Get it at https://console.groq.com/keys — free tier available.
GROQ_API_KEY=
# Optional overrides. Groq's model lineup changes over time and old model IDs
# get retired — if you get a 404 "model does not exist" error, check the
# current list with: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_MODEL=openai/gpt-oss-120b

# --- Anthropic: only needed if LLM_PROVIDER=anthropic ---
# Get a key at https://console.anthropic.com/settings/keys (no free tier, prepaid credits required)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- OpenAI: only needed if TRANSCRIPTION_PROVIDER=openai ---
# https://platform.openai.com/api-keys (no free tier, billing required)
OPENAI_API_KEY=

# --- AssemblyAI: only needed if TRANSCRIPTION_PROVIDER=assemblyai ---
# https://www.assemblyai.com/app/account (free trial credit to start)
ASSEMBLYAI_API_KEY=

# --- Ollama: only needed if LLM_PROVIDER=ollama ---
# No key. Install from https://ollama.com, run `ollama pull llama3.1`, then
# make sure Ollama is running (it runs in the background after install, or
# start it manually with `ollama serve`).
# Only reachable when running this app locally (npm run dev) — a Vercel
# deployment can't reach a process on your own machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
